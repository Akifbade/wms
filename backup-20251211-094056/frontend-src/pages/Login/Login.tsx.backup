import React, { useState, useEffect } from 'react';
import {
  LockClosedIcon,
  EnvelopeIcon,
  EyeIcon,
  EyeSlashIcon,
  CubeIcon,
  ArrowRightIcon,
  TruckIcon,
  GlobeAmericasIcon,
  ShieldCheckIcon,
  SparklesIcon
} from '@heroicons/react/24/outline';
import { authAPI } from '../../services/api';

// --- MODERN CONFIGURATION ---
// Centralized settings for easy customization
const LOGIN_THEME = {
  colors: {
    primary: '#3B82F6',    // Bright Blue (Cyber)
    secondary: '#8B5CF6',  // Violet (Neon)
    accent: '#10B981',     // Emerald (Success)
    background: '#0f172a', // Slate 900 (Deep Space)
    surface: '#1e293b',    // Slate 800 (Panel)
  },
  effects: {
    glassOpacity: 0.7,     // 0.0 to 1.0
    blurStrength: '16px',  // Backdrop blur
    glowIntensity: 'high', // low, medium, high
    enableCursor: true,    // Custom Gemini cursor
    enable3D: true,        // 3D floating elements
  },
  content: {
    companyName: 'Warehouse WMS',
    tagline: 'Next-Gen Logistics Management',
    showLogo: true,
    logoSize: 'medium', // small, medium, large
  }
};

interface Branding {
  logo?: string;
  name?: string;
  primaryColor?: string;
  secondaryColor?: string;
  showCompanyName?: boolean;
  logoSize?: string;
}

export const Login: React.FC = () => {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [rememberMe, setRememberMe] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [showPassword, setShowPassword] = useState(false);

  // Merged State for Settings
  const [settings, setSettings] = useState({
    ...LOGIN_THEME.content,
    logo: undefined as string | undefined,
    showCompanyName: true,
    primaryColor: LOGIN_THEME.colors.primary,
    secondaryColor: LOGIN_THEME.colors.secondary,
    enableCursor: LOGIN_THEME.effects.enableCursor,
    enable3D: LOGIN_THEME.effects.enable3D,
    blurStrength: LOGIN_THEME.effects.blurStrength,
    themeMode: 'system',
    loginVideoUrl: undefined as string | undefined,
    loginVideoEnabled: true,
    loginBackgroundType: 'video',
    loginBackgroundImage: undefined as string | undefined,
    loginShowFeatures: true,
  });

  // Mouse position state for cursor effect
  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });

  useEffect(() => {
    if (!settings.enableCursor) return;

    const handleMouseMove = (e: MouseEvent) => {
      setMousePos({ x: e.clientX, y: e.clientY });
    };

    window.addEventListener('mousemove', handleMouseMove);
    return () => window.removeEventListener('mousemove', handleMouseMove);
  }, [settings.enableCursor]);

  // Load dynamic branding settings (optional override)
  useEffect(() => {
    const loadBranding = async () => {
      try {
        const response = await fetch('/api/company/branding');
        if (response.ok) {
          const data = await response.json();
          setSettings(prev => ({
            ...prev,
            companyName: data.branding.name || prev.companyName,
            logo: data.branding.logoUrl || data.branding.logo, // Keep default if null
            primaryColor: data.branding.primaryColor || prev.primaryColor,
            secondaryColor: data.branding.secondaryColor || prev.secondaryColor,
            showCompanyName: data.branding.showCompanyName !== false,
            logoSize: data.branding.logoSize || prev.logoSize,
            enableCursor: data.branding.loginEnableCursor !== false,
            enable3D: data.branding.loginEnable3D !== false,
            blurStrength: data.branding.loginBlurStrength || prev.blurStrength,
            themeMode: data.branding.loginThemeMode || 'system',
            loginVideoUrl: data.branding.loginVideoUrl || prev.loginVideoUrl,
            loginVideoEnabled: data.branding.loginVideoEnabled !== false,
            loginBackgroundType: data.branding.loginBackgroundType || 'video',
            loginBackgroundImage: data.branding.loginBackgroundImage || prev.loginBackgroundImage,
            loginShowFeatures: data.branding.loginShowFeatures !== false,
          }));
        }
      } catch (error) {
        // Silent fail, use defaults
      }
    };
    loadBranding();
  }, []);

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setError('');

    try {
      await authAPI.login(email, password);
      await new Promise(resolve => setTimeout(resolve, 800)); // Longer delay for animation
      window.location.href = '/dashboard';
    } catch (err: any) {
      setError(err.message || 'Invalid credentials');
      setLoading(false);
    }
  };

  const logoSizeClass = settings.logoSize === 'small' ? 'h-12' : settings.logoSize === 'large' ? 'h-24' : 'h-16';

  const getBlurValue = (strength: string) => {
    switch (strength) {
      case 'none': return '0px';
      case 'low': return '8px';
      case 'medium': return '16px';
      case 'high': return '24px';
      default: return strength; // Fallback if it's already a pixel value
    }
  };

  return (
    <div className={`min-h-screen w-full flex overflow-hidden bg-[${LOGIN_THEME.colors.background}] relative ${settings.enableCursor ? 'cursor-none' : ''}`}>
      {/* CSS for Animations */}
      <style>{`
        @keyframes float {
          0% { transform: translateY(0px); }
          50% { transform: translateY(-20px); }
          100% { transform: translateY(0px); }
        }
        @keyframes float-delayed {
          0% { transform: translateY(0px); }
          50% { transform: translateY(-15px); }
          100% { transform: translateY(0px); }
        }
        @keyframes pulse-glow {
          0%, 100% { opacity: 0.5; transform: scale(1); }
          50% { opacity: 0.8; transform: scale(1.05); }
        }
        @keyframes slide-up {
          from { opacity: 0; transform: translateY(20px); }
          to { opacity: 1; transform: translateY(0); }
        }
        @keyframes gradient-x {
          0% { background-position: 0% 50%; }
          50% { background-position: 100% 50%; }
          100% { background-position: 0% 50%; }
        }
        .animate-float { animation: float 6s ease-in-out infinite; }
        .animate-float-delayed { animation: float-delayed 8s ease-in-out infinite; }
        .animate-pulse-glow { animation: pulse-glow 4s ease-in-out infinite; }
        .animate-slide-up { animation: slide-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .animate-gradient-x { background-size: 200% 200%; animation: gradient-x 3s ease infinite; }
        
        .glass-panel {
          background: rgba(255, 255, 255, 0.03);
          backdrop-filter: blur(${getBlurValue(settings.blurStrength)});
          -webkit-backdrop-filter: blur(${getBlurValue(settings.blurStrength)});
          border: 1px solid rgba(255, 255, 255, 0.05);
          box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        
        .input-group:focus-within label {
          color: ${settings.primaryColor};
        }
        .input-group:focus-within svg {
          color: ${settings.primaryColor};
        }
      `}</style>

      {/* Custom Cursor Elements */}
      {settings.enableCursor && (
        <>
          <div
            className="pointer-events-none fixed z-[100] mix-blend-screen transition-transform duration-75 ease-out"
            style={{
              left: 0,
              top: 0,
              transform: `translate(${mousePos.x}px, ${mousePos.y}px) translate(-50%, -50%)`
            }}
          >
            {/* Inner Dot */}
            <div className="w-2 h-2 bg-white rounded-full shadow-[0_0_10px_rgba(255,255,255,0.8)]"></div>
          </div>

          <div
            className="pointer-events-none fixed z-[99] mix-blend-screen transition-transform duration-300 ease-out"
            style={{
              left: 0,
              top: 0,
              transform: `translate(${mousePos.x}px, ${mousePos.y}px) translate(-50%, -50%)`
            }}
          >
            {/* Outer Glow Ring */}
            <div
              className="w-8 h-8 rounded-full border border-white/30 bg-white/5 backdrop-blur-[1px]"
              style={{
                boxShadow: `0 0 20px ${settings.primaryColor}40, inset 0 0 10px ${settings.primaryColor}20`
              }}
            ></div>
          </div>

          <div
            className="pointer-events-none fixed z-[98] transition-opacity duration-500"
            style={{
              left: 0,
              top: 0,
              transform: `translate(${mousePos.x}px, ${mousePos.y}px) translate(-50%, -50%)`,
              background: `radial-gradient(circle, ${settings.primaryColor}30 0%, transparent 70%)`,
              width: '400px',
              height: '400px',
              opacity: 0.4
            }}
          ></div>
        </>
      )}

      {/* Animated Background Elements */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none">
        {/* Gradient Orbs */}
        <div className="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full mix-blend-screen filter blur-[100px] opacity-30 animate-pulse-glow"
          style={{ background: `radial-gradient(circle, ${settings.primaryColor}, transparent)` }}></div>
        <div className="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full mix-blend-screen filter blur-[100px] opacity-20 animate-pulse-glow"
          style={{ background: `radial-gradient(circle, ${settings.secondaryColor}, transparent)`, animationDelay: '2s' }}></div>

        {/* Grid Pattern */}
        <div className="absolute inset-0 opacity-[0.03]"
          style={{
            backgroundImage: `linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px)`,
            backgroundSize: '40px 40px'
          }}>
        </div>
      </div>

      {/* Main Content Container */}
      <div className="relative z-10 w-full flex flex-col lg:flex-row">

        {/* Left Side - Login Form */}
        <div className="flex-1 flex flex-col justify-center items-center p-6 lg:p-12">
          <div className="w-full max-w-md animate-slide-up" style={{ animationDelay: '0.1s' }}>

            {/* Logo & Header */}
            <div className="text-center mb-10 relative">
              <div className="absolute -inset-4 bg-gradient-to-r from-blue-500/20 to-purple-500/20 blur-xl rounded-full opacity-50 animate-pulse-glow"></div>
              {settings.logo ? (
                <img
                  src={settings.logo}
                  alt="Logo"
                  className={`${logoSizeClass} w-auto mx-auto mb-6 relative drop-shadow-2xl`}
                />
              ) : (
                <div className="h-20 w-20 mx-auto mb-6 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-2xl shadow-blue-500/30 relative transform rotate-3 hover:rotate-0 transition-transform duration-500">
                  <CubeIcon className="h-10 w-10 text-white" />
                </div>
              )}

              <h2 className="text-4xl font-bold text-white tracking-tight mb-2">
                {settings.showCompanyName && (settings.companyName || 'Warehouse WMS')}
              </h2>
              <p className="text-slate-400 text-lg">{settings.tagline}</p>
            </div>

            {/* Glass Card */}
            <div className="glass-panel rounded-3xl p-8 lg:p-10 relative overflow-hidden group">
              {/* Shine Effect */}
              <div className="absolute inset-0 bg-gradient-to-tr from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

              <form onSubmit={handleLogin} className="space-y-6 relative z-10">
                {error && (
                  <div className="bg-red-500/10 border border-red-500/20 p-4 rounded-xl flex items-center gap-3 animate-slide-up">
                    <div className="p-2 bg-red-500/20 rounded-full">
                      <svg className="h-4 w-4 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clipRule="evenodd" />
                      </svg>
                    </div>
                    <p className="text-sm text-red-200 font-medium">{error}</p>
                  </div>
                )}

                <div className="space-y-5">
                  <div className="input-group">
                    <label className="block text-sm font-medium text-slate-300 mb-1.5 ml-1 transition-colors">Email Address</label>
                    <div className="relative group/input">
                      <div className="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-500 rounded-xl blur opacity-20 group-hover/input:opacity-40 transition-opacity duration-300"></div>
                      <div className="relative bg-[#1e293b] rounded-xl border border-slate-700/50 focus-within:border-blue-500/50 transition-colors overflow-hidden">
                        <div className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 transition-colors">
                          <EnvelopeIcon className="h-5 w-5" />
                        </div>
                        <input
                          type="email"
                          required
                          value={email}
                          onChange={(e) => setEmail(e.target.value)}
                          className={`w-full bg-transparent text-white placeholder-slate-500 pl-12 pr-4 py-3.5 outline-none ${settings.enableCursor ? 'cursor-none' : ''}`}
                          placeholder="name@company.com"
                        />
                      </div>
                    </div>
                  </div>

                  <div className="input-group">
                    <label className="block text-sm font-medium text-slate-300 mb-1.5 ml-1 transition-colors">Password</label>
                    <div className="relative group/input">
                      <div className="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-500 rounded-xl blur opacity-20 group-hover/input:opacity-40 transition-opacity duration-300"></div>
                      <div className="relative bg-[#1e293b] rounded-xl border border-slate-700/50 focus-within:border-blue-500/50 transition-colors overflow-hidden">
                        <div className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 transition-colors">
                          <LockClosedIcon className="h-5 w-5" />
                        </div>
                        <input
                          type={showPassword ? 'text' : 'password'}
                          required
                          value={password}
                          onChange={(e) => setPassword(e.target.value)}
                          className={`w-full bg-transparent text-white placeholder-slate-500 pl-12 pr-12 py-3.5 outline-none ${settings.enableCursor ? 'cursor-none' : ''}`}
                          placeholder="••••••••"
                        />
                        <button
                          type="button"
                          onClick={() => setShowPassword(!showPassword)}
                          className={`absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 transition-colors ${settings.enableCursor ? 'cursor-none' : ''}`}
                        >
                          {showPassword ? <EyeSlashIcon className="h-5 w-5" /> : <EyeIcon className="h-5 w-5" />}
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="flex items-center justify-between pt-2">
                  <label className="flex items-center cursor-pointer group">
                    <div className="relative">
                      <input
                        type="checkbox"
                        checked={rememberMe}
                        onChange={(e) => setRememberMe(e.target.checked)}
                        className="sr-only"
                      />
                      <div className={`w-5 h-5 rounded border transition-colors ${rememberMe ? 'bg-blue-500 border-blue-500' : 'bg-[#1e293b] border-slate-600 group-hover:border-slate-500'}`}>
                        {rememberMe && <svg className="w-3 h-3 text-white absolute top-1 left-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={3} d="M5 13l4 4L19 7" /></svg>}
                      </div>
                    </div>
                    <span className="ml-2 text-sm text-slate-400 group-hover:text-slate-300 transition-colors">Remember me</span>
                  </label>
                  <a href="#" className={`text-sm font-medium text-blue-400 hover:text-blue-300 transition-colors ${settings.enableCursor ? 'cursor-none' : ''}`}>Forgot password?</a>
                </div>

                <button
                  type="submit"
                  disabled={loading}
                  className={`w-full relative group overflow-hidden rounded-xl p-[1px] ${settings.enableCursor ? 'cursor-none' : ''}`}
                >
                  <div className="absolute inset-0 bg-gradient-to-r from-blue-500 via-indigo-500 to-blue-500 animate-gradient-x"></div>
                  <div className="relative bg-[#1e293b] group-hover:bg-opacity-0 transition-all duration-300 rounded-xl px-4 py-3.5 flex items-center justify-center">
                    {loading ? (
                      <div className="flex items-center gap-2 text-white font-semibold">
                        <svg className="animate-spin h-5 w-5" viewBox="0 0 24 24">
                          <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none"></circle>
                          <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Authenticating...</span>
                      </div>
                    ) : (
                      <div className="flex items-center gap-2 text-white font-semibold group-hover:scale-105 transition-transform">
                        <span>Sign In to Dashboard</span>
                        <ArrowRightIcon className="h-5 w-5 group-hover:translate-x-1 transition-transform" />
                      </div>
                    )}
                  </div>
                </button>
              </form>

              {/* Demo Credentials */}
              <div className="mt-8 pt-6 border-t border-slate-700/50">
                <p className="text-xs text-slate-500 text-center mb-4 uppercase tracking-wider font-semibold">Quick Access</p>
                <div className="grid grid-cols-2 gap-3">
                  <button
                    onClick={() => { setEmail('admin@demo.com'); setPassword('demo123'); }}
                    className={`px-4 py-2 rounded-lg bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700 hover:border-slate-600 text-slate-300 text-sm transition-all hover:scale-105 ${settings.enableCursor ? 'cursor-none' : ''}`}
                  >
                    Admin
                  </button>
                  <button
                    onClick={() => { setEmail('manager@demo.com'); setPassword('demo123'); }}
                    className={`px-4 py-2 rounded-lg bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700 hover:border-slate-600 text-slate-300 text-sm transition-all hover:scale-105 ${settings.enableCursor ? 'cursor-none' : ''}`}
                  >
                    Manager
                  </button>
                </div>
              </div>
            </div>

            <p className="text-center text-slate-500 text-sm mt-8">
              © {new Date().getFullYear()} {settings.companyName || 'Warehouse WMS'}. Secure System.
            </p>
          </div>
        </div>

        {/* Right Side - 3D/CGI Visuals */}
        <div className="hidden lg:flex flex-1 relative overflow-hidden bg-[#020617] items-center justify-center">
          {/* Background Media (Video or Image) */}
          <div className="absolute inset-0 z-0">
            {settings.loginBackgroundType === 'video' && settings.loginVideoUrl ? (
              <video
                autoPlay
                loop
                muted
                playsInline
                className="w-full h-full object-cover opacity-40"
              >
                <source src={settings.loginVideoUrl} type="video/mp4" />
              </video>
            ) : (
              <img
                src={settings.loginBackgroundImage || "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80"}
                alt="Warehouse"
                className="w-full h-full object-cover opacity-20"
              />
            )}
            <div className="absolute inset-0 bg-gradient-to-t from-[#020617] via-[#020617]/80 to-transparent"></div>
            <div className="absolute inset-0 bg-gradient-to-r from-[#0f172a] to-transparent"></div>
          </div>

          {/* 3D Floating Elements Container */}
          {settings.loginShowFeatures && (
          <div className="relative z-10 w-full max-w-2xl p-12 perspective-1000">

            {/* Main Floating Card */}
            <div className="relative animate-float">
              <div className="absolute -inset-1 bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl blur opacity-30"></div>
              <div className="relative bg-[#1e293b]/80 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-8 shadow-2xl transform rotate-y-12 hover:rotate-y-0 transition-transform duration-700">

                {/* Holographic Header */}
                <div className="flex items-center justify-between mb-8 border-b border-slate-700/50 pb-6">
                  <div className="flex items-center gap-4">
                    <div className="p-3 bg-blue-500/20 rounded-xl border border-blue-500/30">
                      <GlobeAmericasIcon className="h-8 w-8 text-blue-400" />
                    </div>
                    <div>
                      <h3 className="text-xl font-bold text-white">Global Operations</h3>
                      <div className="flex items-center gap-2 mt-1">
                        <span className="relative flex h-2 w-2">
                          <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                          <span className="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                        </span>
                        <span className="text-xs text-green-400 font-mono">SYSTEM ONLINE</span>
                      </div>
                    </div>
                  </div>
                  <div className="text-right">
                    <p className="text-xs text-slate-400 font-mono">LAT: 40.7128° N</p>
                    <p className="text-xs text-slate-400 font-mono">LNG: 74.0060° W</p>
                  </div>
                </div>

                {/* Stats Grid */}
                <div className="grid grid-cols-2 gap-4 mb-8">
                  <div className="bg-[#0f172a]/50 rounded-xl p-4 border border-slate-700/50 hover:border-blue-500/30 transition-colors group">
                    <div className="flex items-center gap-3 mb-2">
                      <TruckIcon className="h-5 w-5 text-blue-400 group-hover:scale-110 transition-transform" />
                      <span className="text-slate-400 text-sm">Active Fleet</span>
                    </div>
                    <p className="text-2xl font-bold text-white">1,248</p>
                    <div className="w-full bg-slate-700/50 h-1 mt-3 rounded-full overflow-hidden">
                      <div className="bg-blue-500 h-full w-[75%] animate-pulse"></div>
                    </div>
                  </div>
                  <div className="bg-[#0f172a]/50 rounded-xl p-4 border border-slate-700/50 hover:border-purple-500/30 transition-colors group">
                    <div className="flex items-center gap-3 mb-2">
                      <CubeIcon className="h-5 w-5 text-purple-400 group-hover:scale-110 transition-transform" />
                      <span className="text-slate-400 text-sm">Inventory</span>
                    </div>
                    <p className="text-2xl font-bold text-white">98.4%</p>
                    <div className="w-full bg-slate-700/50 h-1 mt-3 rounded-full overflow-hidden">
                      <div className="bg-purple-500 h-full w-[92%] animate-pulse"></div>
                    </div>
                  </div>
                </div>

                {/* Activity Feed */}
                <div className="space-y-3">
                  <div className="flex items-center gap-3 text-sm text-slate-300 bg-[#0f172a]/30 p-3 rounded-lg border border-slate-800">
                    <ShieldCheckIcon className="h-4 w-4 text-green-400" />
                    <span>Secure connection established via TLS 1.3</span>
                  </div>
                  <div className="flex items-center gap-3 text-sm text-slate-300 bg-[#0f172a]/30 p-3 rounded-lg border border-slate-800">
                    <SparklesIcon className="h-4 w-4 text-yellow-400" />
                    <span>Real-time synchronization active</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Floating Elements Behind */}
            <div className="absolute -top-10 -right-10 w-32 h-32 bg-blue-600/20 rounded-full blur-2xl animate-float-delayed"></div>
            <div className="absolute -bottom-10 -left-10 w-40 h-40 bg-purple-600/20 rounded-full blur-2xl animate-float-delayed" style={{ animationDelay: '2s' }}></div>

          </div>
          )}
        </div>
      </div>
    </div>
  );
};
