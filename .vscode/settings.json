{
    "git.ignoreLimitWarning": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        }
    },
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        "**/.next/**": true,
        "**/dist/**": false
    },
    "typescript.strict": true,
    "typescript.checkJs": true,
    "[typescript]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },
    "[typescriptreact]": {
        "editor.formatOnSave": true
    },
    "git.decorations.enabled": true,
    "git.detectSubmodules": false,
    "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK"],
    "task.autoDetect": "on",
    "task.quickOpen.detail": true,
    "task.quickOpen.skip": false,
    
    // =============================================================================
    // 🚀 PROJECT: Warehouse Management System (WMS)
    // =============================================================================
    "project.name": "WMS - QGO Cargo",
    "project.description": "Full-stack warehouse management system with QR scanning, shipment tracking, and fleet management",
    "project.version": "v2.1.125",
    "project.branch": "stable/prisma-mysql-production",
    "project.github": "https://github.com/Akifbade/wms",
    
    // =============================================================================
    // 🌐 VPS SERVER DETAILS (Rocky Linux 9.x)
    // =============================================================================
    "vps.host": "148.230.107.155",
    "vps.user": "root",
    "vps.path": "/root/NEW START",
    "vps.os": "Rocky Linux 9.x (RHEL-based)",
    "vps.docker": "Docker + Docker Compose v3.8",
    
    // =============================================================================
    // 🔗 ENVIRONMENTS
    // =============================================================================
    "env.localhost.frontend": "http://localhost:80",
    "env.localhost.backend": "http://localhost:5000",
    "env.localhost.database": "localhost:3306 (warehouse_wms)",
    
    "env.staging.frontend": "http://148.230.107.155:8080",
    "env.staging.backend": "http://148.230.107.155:5001",
    "env.staging.database": "148.230.107.155:3308 (warehouse_staging)",
    "env.staging.credentials": "admin@demo.com / demo123",
    "env.staging.deployment": "AUTO on push",
    "env.staging.compose": "docker-compose-staging-isolated.yml",
    
    "env.production.frontend": "https://qgocargo.cloud",
    "env.production.backend": "https://qgocargo.cloud/api",
    "env.production.database": "148.230.107.155:3307 (warehouse_wms)",
    "env.production.ssl": "Let's Encrypt (auto-renew)",
    "env.production.deployment": "MANUAL approval via GitHub Actions",
    "env.production.compose": "docker-compose.yml + docker-compose.production.yml",
    
    // =============================================================================
    // 🗄️ DATABASE CREDENTIALS
    // =============================================================================
    "db.staging.host": "148.230.107.155:3308",
    "db.staging.database": "warehouse_staging",
    "db.staging.user": "staging_user",
    "db.staging.password": "staging_pass_12345",
    "db.staging.container": "wms-staging-db",
    
    "db.production.host": "148.230.107.155:3307",
    "db.production.database": "warehouse_wms",
    "db.production.root_password": "rootpassword123",
    "db.production.user": "wms_user",
    "db.production.password": "wmspassword123",
    "db.production.container": "wms-database",
    
    // =============================================================================
    // 🚀 DEPLOYMENT PROCESS (3-STAGE)
    // =============================================================================
    "deployment.step1": "Local - Test on localhost",
    "deployment.step2": "Commit & Push - Use quick-commit.ps1",
    "deployment.step3": "Staging - Auto-deploys in 3-5 min",
    "deployment.step4": "Test Staging - Login admin@demo.com / demo123",
    "deployment.step5": "Production - Manual approval on GitHub Actions",
    "deployment.workflow_file": ".github/workflows/three-stage-safe-deployment.yml",
    "deployment.github_actions": "https://github.com/Akifbade/wms/actions",
    
    // =============================================================================
    // 🔐 GITHUB SECRETS (DO NOT DELETE!)
    // =============================================================================
    "github.secret.vps": "STAGING_VPS_SSH_KEY (used for both staging and production)",
    "github.warning": "SSH key already configured - NEVER modify or delete",
    
    // =============================================================================
    // ⚠️ CRITICAL RULES FOR AI ASSISTANTS
    // =============================================================================
    "ai.rule1": "NEVER delete or modify SSH keys",
    "ai.rule2": "ALWAYS test on staging before production",
    "ai.rule3": "NEVER skip database backups",
    "ai.rule4": "Keep only 2 backups (auto-cleanup enabled)",
    "ai.rule5": "Staging is ISOLATED (separate DB, network, containers)",
    "ai.rule6": "Use GitHub Actions for all deployments",
    "ai.rule7": "Staging password is admin@demo.com / demo123",
    "ai.rule8": "ALWAYS USE GIT FLOW - NEVER deploy directly to VPS",
    "ai.rule9": "Read .github/copilot-instructions.md for deployment rules",
    "ai.documentation": "Read THREE-STAGE-DEPLOYMENT-GUIDE.md for full details",
    
    // =============================================================================
    // 🚀 GIT FLOW DEPLOYMENT (MANDATORY)
    // =============================================================================
    "deployment.flow.step1": "git add -A",
    "deployment.flow.step2": "git commit --no-verify -m 'message'",
    "deployment.flow.step3": "git push origin stable/prisma-mysql-production",
    "deployment.flow.step4": "GitHub Actions auto-deploys to VPS",
    "deployment.flow.warning": "NEVER use plink/pscp to deploy - ONLY for debugging",
    
    // =============================================================================
    // 🔌 GITHUB COPILOT INTEGRATION
    // =============================================================================
    "github.copilot.enable": {
        "*": true
    },
    "github.copilot.advanced": {
        "inlineSuggest.enable": true
    },
    
    // =============================================================================
    // 🔄 AUTO-VERSION & AUTO-COMMIT SYSTEM
    // =============================================================================
    "git.enabled": true,
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.postCommitCommand": "none",
    "autoversion.enabled": true,
    "autoversion.script": ".vscode/auto-version-and-commit.ps1",
    "autoversion.description": "Every rebuild auto-increments version and commits to git for safety",
    "autoversion.format": "🔄 Auto-increment version to vX.X.X (rebuild safety)",
    "github.copilot.chat.tools.memory.enabled": true
}
