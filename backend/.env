# Docker MySQL (used by local prisma CLI commands too)
# Keep in sync with workspace root .env (DB_USER/DB_PASSWORD/DB_PORT)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
PORT=5000
NODE_ENV=development

# WhatsApp Business API
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER=""

# Email SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# SMS Gateway
SMS_API_KEY=""
SMS_SENDER_ID=""

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost"

# Public URL used in emails/cron links (set to your domain on VPS)
APP_PUBLIC_URL="http://localhost"

# Fleet Management
FLEET_ENABLED=false
FLEET_GPS_SAMPLE_MS=30000
FLEET_IDLE_SPEED_KMPH=5
FLEET_IDLE_MIN=5
FLEET_SPEED_MAX_KMPH=120
FLEET_MAX_JUMP_METERS=500
FLEET_CARD_LIMIT_DEFAULT=25.000
FLEET_CARD_ALERT_PERCENT=80
FLEET_AUTO_END_MINS=20
GOOGLE_MAPS_KEY=

# Fleet Background Jobs
FLEET_JOBS_ENABLED=true
FLEET_JOBS_DRY_RUN=false
DATABASE_URL="mysql://wms_user_staging:***@wms-database-staging:3306/warehouse_wms_staging"
