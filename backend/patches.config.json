{
  "patches": [
    {
      "id": "performance-monitor",
      "module": "performance-monitor",
      "description": "Track API response times and identify slow endpoints",
      "version": "1.0.0",
      "enabled": true,
      "appliesTo": ["backend"],
      "allowFrontendFallback": false
    },
    {
      "id": "request-logger",
      "module": "request-logger",
      "description": "Log all API requests with detailed metrics",
      "version": "1.0.0",
      "enabled": true,
      "appliesTo": ["backend"],
      "allowFrontendFallback": false
    },
    {
      "id": "audit-logger",
      "module": "audit-logger",
      "description": "🔒 SECURITY: Track all ADMIN/MANAGER actions - who changed what data & when",
      "version": "1.0.0",
      "enabled": true,
      "appliesTo": ["backend"],
      "allowFrontendFallback": false
    }
  ]
}
